# Copy to .env and fill in. .env is gitignored.
# In CI these are GitHub Actions secrets — see .github/workflows/scraper_cron.yml.

# ── Telegram (required) ────────────────────────────────────────────────
# TelegramNotifier raises at startup if either is missing.
# Bot token from @BotFather; chat id from @userinfobot.
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenReplaceMe
TELEGRAM_CHAT_ID=123456789

# ── Search (optional) ──────────────────────────────────────────────────
# Comma-separated. Each term becomes one JobsDB API query.
SEARCH_KEYWORDS=python developer,data engineer

# Comma-separated title relevance keywords (English + Thai). A job is kept if
# its title contains any of them, matched as a lowercase substring.
# Leave unset to use the built-in default in main.DEFAULT_TITLE_FILTER.
TITLE_FILTER=python,django,fastapi,data,software,backend,programmer,developer,engineer,analyst,devops,cloud,fullstack,full stack,นักพัฒนา,โปรแกรมเมอร์,วิศวกร,นักวิเคราะห์

# ── Gemini semantic filter (optional, off by default) ──────────────────
# Adds an LLM relevance pass over the jobs that survive the keyword filters —
# it drops non-engineering roles that merely mention Python. Every failure path
# keeps all jobs, so enabling it can never cost you an alert.
# Free tier is ~10 requests/min; the filter batches 40 jobs per request.
# Key from https://aistudio.google.com/apikey
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
